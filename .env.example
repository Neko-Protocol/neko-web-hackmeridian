# Stellar Network Configuration
# On TESTNET only Neko Pro and Settings are usable; mainnet-only pages are grayed out.
NEXT_PUBLIC_STELLAR_NETWORK=MAINNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015" 
# Routed through the backend gateway, which owns the endpoint pool and the
# provider API keys. A path here keeps credentials off the client entirely
# Set an absolute provider URL instead to bypass the gateway — that is the
# rollback, and it is a config change rather than a deploy.
NEXT_PUBLIC_STELLAR_RPC_URL=/api/rpc
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon.stellar.org

# Neko Pro vaults run on testnet, apart from the network above. Defaults to
# the SDF testnet endpoint.
NEXT_PUBLIC_PRO_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# xBull Swap referral fees are charged in the output asset. Use a Stellar
# account or contract address able to receive every output asset we support.
SWAP_REFERRAL_ADDRESS=
# Soroswap credential, server-side only (replaces NEXT_PUBLIC_SOROSWAP_API_KEY)
SOROSWAP_API_KEY=
# 32 random bytes as hex, shared by every worker; rotating it invalidates
# outstanding quotes. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OPPIA_QUOTE_SECRET=

# Etherfuse FX
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com

# Alfred Pay
ALFREDPAY_API_KEY=
ALFREDPAY_API_SECRET=
ALFREDPAY_BASE_URL=https://api-service-co.alfredpay.app/api/v1/third-party-service/penny
ALFREDPAY_WEBHOOK_SECRET=

# DeFindex HTTP API key
DEFINDEX_API_KEY=

# Supabase - audit logs + users
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Storage bucket holding the Neko Pro vault photos, keyed by file name in
# features/shared/pro/constants/presentation.ts. Unset the Supabase URL above and
# vaults fall back to their gradient.
NEXT_PUBLIC_PRO_IMAGES_BUCKET=pro-images

# App origin used for Supabase magic-link redirects.
# Production should match Supabase Auth > URL Configuration > Site URL.
NEXT_PUBLIC_APP_URL=https://app.nekoprotocol.xyz

# Neko backend (transaction relay). Server-only.
# BACKEND_INTERNAL_KEY must match Railway INTERNAL_API_KEY.
BACKEND_INTERNAL_URL=http://localhost:4000
BACKEND_INTERNAL_KEY=

# Use backend dashboard
NEXT_PUBLIC_USE_BACKEND_DASHBOARD=false

# ── Neko Pro KYC/KYB gate (HackMeridian, testnet) ──
# "true" shows a "Skip verification" option on /pro so judges can get a mocked,
# approved verification without Didit. Needs KYC_MOCK_ENABLED=true on the
# backend too. Hackathon only: leave unset in production.
NEXT_PUBLIC_KYC_MOCK_ENABLED=true

# Privy (email sign-in with an embedded Stellar wallet). Same app as the
# backend's PRIVY_APP_ID. Unset → only "Connect a Stellar wallet" shows.
# On testnet the embedded wallet is funded with friendbot on first sign-in.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: the web app client from Privy dashboard > App clients.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
